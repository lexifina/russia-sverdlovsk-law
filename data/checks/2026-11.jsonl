-4b01-9576-b4a7d4fde1fb&DocumentTypes=c0281bbe-6be1-45be-8acd-f319c99b85ad&DocumentTypes=50acf12d-2461-466e-bada-de5d8b7737a1&DocumentTypes=1ee8f2cc-d23f-4ac1-a0e4-1fd202ecc736&DocumentTypes=5cf51861-5b6f-4210-9776-8086c05fdc8b&DocumentTypes=cdafe085-10fe-4199-92a5-9aa82b2b6c99&DocumentTypes=bdfe8274-cfc2-4a62-b413-91a201646ced&DocumentTypes=8910e61f-371d-490c-a1b8-aa7b8a5a48be&DocumentTypes=e880fa45-e4f4-4db9-bba0-847666adebab&DocumentTypes=16b9a101-4ce2-47d0-8a92-8b1aff72867a&PageSize=200&Index=9&SortedBy=5&SortDestination=asc"}, {"at": "2026-11-25T06:38:07Z", "bytes": 1555, "method": "GET", "status": 200, "url": "http://publication.pravo.gov.ru/api/Document?eoNumber=6600201606090013"}, {"at": "2026-11-25T06:38:10Z", "bytes": 1657, "method": "GET", "status": 200, "url": "http://publication.pravo.gov.ru/api/Document?eoNumber=6600201611210002"}], "runner": "lawwatch russia (65e3dde363)", "schema": "lexifina-check/1", "seen": {"added": ["6600202611250001", "6600202611250002", "6600202611250003", "6600202611250004", "6600202611250005", "6600202611250006", "6600202611250007", "6600202611250008", "6600202611250009", "6600202611250010", "6600202611250011", "6600202611250012", "6600202611250013", "6600202611250014", "6600202611250015", "6600202611250016", "6600202611250017", "6600202611250018", "6600202611250019", "6600202611250020", "6600202611250021", "6600202611250022", "6600202611250024"], "changed": [], "removed": []}, "snapshot": "1793 law-type documents in block region66; newest published 2026-11-25", "source": "pravo-sverdlovsk", "started": "2026-11-25T06:36:46Z", "titles": {"6600202611250001": "О переводе земельного участка, расположенного на территории Невьянского муниципального округа Свердловской области, с кадастровым номером 66:15:0403001:656 из к", "6600202611250002": "О переводе отдельных земельных участков, расположенных на территории Новоуральского городского округа Свердловской области, из категории земель сельскохозяйстве", "6600202611250003": "О переводе земельного участка, расположенного на территории Новоуральского городского округа Свердловской области, с кадастровым номером 66:57:0211002:127 из ка", "6600202611250004": "О внесении изменений в статью 30 Закона Свердловской области «Об особенностях регулирования земельных отношений на территории Свердловской области»", "6600202611250005": "О внесении изменения в статью 29-3 Областного закона «О бюджетном процессе в Свердловской области»", "6600202611250006": "О внесении изменений в Закон Свердловской области «Об установлении на территории Свердловской области налога на имущество организаций»", "6600202611250007": "О внесении изменений в отдельные законы Свердловской области", "6600202611250008": "О внесении изменения в приложение к Закону Свердловской области «Об установлении и введении в действие транспортного налога на территории Свердловской области»", "6600202611250009": "Об установлении на 2027 год коэффициента, отражающего региональные особенности рынка труда на территории Свердловской области, и регионального коэффициента к ве", "6600202611250010": "О внесении изменений в статью 42 Закона Свердловской области «Об административных правонарушениях на территории Свердловской области» и статью 3 Закона Свердлов", "6600202611250011": "О внесении изменений в отдельные законы Свердловской области", "6600202611250012": "О внесении изменений в Закон Свердловской области «О государственной поддержке субъектов инвестиционной деятельности в Свердловской области»", "6600202611250013": "О внесении изменений в статьи 5 и 6 Закона Свердловской области «Об установлении на территории Свердловской области налога на имущество организаций»", "6600202611250014": "Об утверждении заключения Соглашения между Свердловской областью и Донецкой Народной Республикой о сотрудничестве в торгово-экономической, научно-технической, с", "6600202611250015": "О признании утратившим силу Закона Свердловской области «О наделении органов местного самоуправления муниципальных образований, расположенных на территории Свер", "6600202611250016": "О внесении изменений в законы Свердловской области, регулирующие отношения, связанные с перераспределением отдельных полномочий в сфере рекламы", "6600202611250017": "О внесении изменения в статью 6 Закона Свердловской области «О социальной поддержке ветеранов в Свердловской области»", "6600202611250018": "О внесении изменений в Закон Свердловской области «Об образовании в Свердловской области»", "6600202611250019": "О внесении изменений в статьи 3 и 4 Закона Свердловской области «О регулировании отдельных отношений в сфере комплексного развития территорий в Свердловской обл", "6600202611250020": "О внесении изменения в статью 18 Закона Свердловской области «О социальной поддержке ветеранов в Свердловской области»", "6600202611250021": "О материнском (семейном) капитале Свердловской области", "6600202611250022": "О внесении изменений в статьи 3 и 5 Закона Свердловской области «О профилактике безнадзорности и правонарушений несовершеннолетних в Свердловской области»", "6600202611250024": "О внесении изменений в статью 23 Областного закона «О защите прав ребенка» и отдельные законы Свердловской области"}, "unexplained": 0, "update": {"append": {"commits": 1, "corrections": null, "extended_acts": ["zakony-2026"], "new_acts": []}, "parts": ["95-watch-20261125-001.json"]}, "verify": {"cycle_days": 1, "examples": [], "held": 13, "method": "the portal's whole listing for the subject (read this check, every page) parsed by the builder (ru_catalogue.parse) and compared, publication day by publication day, with the corpus this repository is built from; each year's newest state rendered by the builder (gitlaw_common) against the files at the tip of main", "ok": true, "swept": 13, "versions_checked": 178, "versions_differ": 0}}
